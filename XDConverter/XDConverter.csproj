<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PreviewBuild Condition="'$(PreviewBuild)' == ''">false</PreviewBuild>
    <AssemblyName>XDConverter</AssemblyName><Product>XD Konverter</Product>
    <SuiteVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\XDSuite\XDSuite.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</SuiteVersion>
    <Version>0.5.2</Version><InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyName Condition="'$(PreviewBuild)' == 'true'">XDConverter.Preview</AssemblyName>
    <Product Condition="'$(PreviewBuild)' == 'true'">XD Konverter Vorschau</Product>
    <DefineConstants Condition="'$(PreviewBuild)' == 'true'">$(DefineConstants);CONVERTER_PREVIEW</DefineConstants>
    <InformationalVersion Condition="'$(PreviewBuild)' == 'true'">$(Version)-preview+automatic-defaults</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/XDConverter.ico</ApplicationIcon>
    <BetaBuild Condition="'$(BetaBuild)' == ''">false</BetaBuild>
    <Description>Audiodateien lokal konvertieren.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BetaBuild)' == 'true'">
    <Version>$(SuiteVersion)</Version><InformationalVersion>$(Version)-Beta+converter.1</InformationalVersion>
    <AssemblyName>XDConverter.Beta</AssemblyName><Product>XD Converter Beta</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);CONVERTER_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/XDConverter.ico"/><Resource Include="Assets/XDConverter-256.png"/></ItemGroup>
  <Target Name="ValidateSuiteVersion" BeforeTargets="BeforeBuild">
    <Error Condition="$([MSBuild]::VersionGreaterThan('$(Version)', '$(SuiteVersion)'))" Text="The converter version cannot exceed the current suite version." />
  </Target>
  <ItemGroup><Compile Include="../design/BetaChrome.cs" Link="BetaChrome.cs" /><Resource Include="Assets/Beta.ico" /></ItemGroup>
  <PropertyGroup Condition="'$(BetaBuild)' == 'true'"><ApplicationIcon>Assets/Beta.ico</ApplicationIcon></PropertyGroup>
</Project>
