<Window x:Class="XDWaveEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:XDWaveEditor"
 Title="{Binding [Title], Source={StaticResource T}}" Width="1240" Height="820" MinWidth="1000" MinHeight="720" Icon="Assets/XDWaveEditor.ico" WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Menu Padding="12,6" Background="White">
   <MenuItem Header="{Binding [File], Source={StaticResource T}}"><MenuItem Header="{Binding [Open], Source={StaticResource T}}" Click="Open_Click" InputGestureText="Ctrl+O"/><MenuItem x:Name="ExportMenu" Header="{Binding [Export], Source={StaticResource T}}" Click="Export_Click" InputGestureText="Ctrl+S"/><Separator/><MenuItem Header="{Binding [Exit], Source={StaticResource T}}" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="{Binding [Edit], Source={StaticResource T}}"><MenuItem x:Name="UndoMenu" Header="{Binding [Undo], Source={StaticResource T}}" Click="Undo_Click" InputGestureText="Ctrl+Z"/><MenuItem x:Name="RedoMenu" Header="{Binding [Redo], Source={StaticResource T}}" Click="Redo_Click" InputGestureText="Ctrl+Y"/><Separator/><MenuItem x:Name="CutMenu" Header="{Binding [Cut], Source={StaticResource T}}" Click="Cut_Click" InputGestureText="Ctrl+X"/><MenuItem x:Name="CopyMenu" Header="{Binding [Copy], Source={StaticResource T}}" Click="Copy_Click" InputGestureText="Ctrl+C"/><MenuItem x:Name="PasteMenu" Header="{Binding [Paste], Source={StaticResource T}}" Click="Paste_Click" InputGestureText="Ctrl+V"/><Separator/><MenuItem Header="{Binding [SelectAll], Source={StaticResource T}}" Click="SelectAll_Click" InputGestureText="Ctrl+A"/></MenuItem>
   <MenuItem Header="Sprache / Language"><MenuItem x:Name="GermanMenu" Header="Deutsch" IsCheckable="True" Click="German_Click"/><MenuItem x:Name="EnglishMenu" Header="English" IsCheckable="True" Click="English_Click"/></MenuItem>
  </Menu>
  <Grid Grid.Row="1" Margin="24,20,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,19"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenButton" Content="{Binding [Open], Source={StaticResource T}}" Click="Open_Click"/><Button x:Name="ExportButton" Content="{Binding [Export], Source={StaticResource T}}" Click="Export_Click" Style="{StaticResource Accent}" Margin="0"/></StackPanel><StackPanel><TextBlock Text="XD Wave Editor" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding [Preview], Source={StaticResource T}}" Foreground="#738094" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="FileInfoText" Foreground="#6A788B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding [WaveHint], Source={StaticResource T}}" MaxWidth="360" Foreground="#738094" FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#172333" CornerRadius="9" ClipToBounds="True"><Grid><local:WaveView x:Name="Wave" Margin="8" AutomationProperties.Name="Audio waveform"/><StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28"><TextBlock Text="{Binding [Empty], Source={StaticResource T}}" Foreground="White" FontSize="19" TextAlignment="Center"/><TextBlock Text="{Binding [Formats], Source={StaticResource T}}" Foreground="#A4B2C3" Margin="0,12,0,0" MaxWidth="430" TextAlignment="Center"/></StackPanel></Grid></Border>
     <ScrollBar x:Name="WaveScroll" Grid.Row="1" Orientation="Horizontal" Height="18" Margin="0,6,0,0" ValueChanged="Scroll_Changed"/>
     <DockPanel Grid.Row="2" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" ToolTip="{Binding [ZoomOut], Source={StaticResource T}}" AutomationProperties.Name="{Binding [ZoomOut], Source={StaticResource T}}" Click="ZoomOut_Click"/><Button Content="+" ToolTip="{Binding [ZoomIn], Source={StaticResource T}}" AutomationProperties.Name="{Binding [ZoomIn], Source={StaticResource T}}" Click="ZoomIn_Click"/><Button Content="{Binding [Fit], Source={StaticResource T}}" Click="Fit_Click" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="{Binding [Play], Source={StaticResource T}}" ToolTip="{Binding [PlayHint], Source={StaticResource T}}" Click="Play_Click" Style="{StaticResource Accent}"/><Button x:Name="StopButton" Content="{Binding [Stop], Source={StaticResource T}}" Click="Stop_Click"/><TextBlock x:Name="PositionText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Margin="10,0,8,0"/></StackPanel></DockPanel>
     <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="SelectionText" FontFamily="Consolas" Foreground="#6A788B" FontSize="11" Margin="0,0,0,9"/></StackPanel>
    </Grid>
    <Border Grid.Column="2" Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="9" Padding="20"><Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/></Style></Border.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding [Edit], Source={StaticResource T}}" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="{Binding [EditHint], Source={StaticResource T}}" Foreground="#6A788B" FontSize="12" Margin="0,8,0,20" LineHeight="19"/>
     <Button x:Name="SelectButton" Content="{Binding [SelectAll], Source={StaticResource T}}" Click="SelectAll_Click" Margin="0,0,0,9"/>
     <Separator Margin="0,4,0,14"/>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CutButton" Content="{Binding [Cut], Source={StaticResource T}}" ToolTip="Ctrl+X" Click="Cut_Click"/><Button x:Name="CopyButton" Grid.Column="1" Content="{Binding [Copy], Source={StaticResource T}}" ToolTip="Ctrl+C" Click="Copy_Click" Margin="0"/></Grid>
     <Button x:Name="PasteButton" Content="{Binding [Paste], Source={StaticResource T}}" ToolTip="Ctrl+V" Click="Paste_Click" Margin="0,0,0,9"/>
     <TextBlock x:Name="ClipboardText" Foreground="#6A788B" FontSize="11" Margin="0,0,0,16"/>
     <Button x:Name="DeleteButton" Content="{Binding [Delete], Source={StaticResource T}}" ToolTip="Delete" Click="Delete_Click" Margin="0,0,0,9"/>
     <Button x:Name="TrimButton" Content="{Binding [Trim], Source={StaticResource T}}" Click="Trim_Click" Margin="0,0,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="UndoButton" Content="{Binding [Undo], Source={StaticResource T}}" ToolTip="Ctrl+Z" Click="Undo_Click"/><Button x:Name="RedoButton" Grid.Column="1" Content="{Binding [Redo], Source={StaticResource T}}" ToolTip="Ctrl+Y" Click="Redo_Click" Margin="0"/></Grid>
    </StackPanel></ScrollViewer></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DFE5ED" BorderThickness="0,1,0,0" Padding="24,11"><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{Binding [Cancel], Source={StaticResource T}}" Click="Cancel_Click" Visibility="Collapsed" Margin="12,0,0,0" Padding="12,5"/><ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="120" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#596A7F" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel></Border>
 </Grid>
</Window>
