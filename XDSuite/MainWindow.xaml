<Window x:Class="XDSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="XD Suite" Icon="Assets/XDSuite.ico" Width="1200" Height="840" MinWidth="1050" MinHeight="760" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" Background="#F4F5FA" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#252539"><Grid Margin="20,28,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="8,0,0,38"><StackPanel Orientation="Horizontal"><Border Background="#C8EF97" CornerRadius="9" Width="42" Height="42"><TextBlock Text="XD" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#242B26"/></Border><TextBlock Text="Suite" Foreground="White" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="PROGRAMME" Foreground="#8487A3" FontSize="9" FontWeight="Bold" Margin="15,0,0,14"/>
        <RadioButton x:Name="AllNav" Style="{StaticResource Nav}" GroupName="Filter" Tag="all" Checked="Filter_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" Margin="0,1,13,0"/><TextBlock Text="Alle Programme"/></StackPanel></RadioButton>
        <RadioButton x:Name="InstalledNav" Style="{StaticResource Nav}" GroupName="Filter" Tag="installed" Checked="Filter_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,1,13,0"/><TextBlock Text="Installiert"/></StackPanel></RadioButton>
        <RadioButton x:Name="UpdatesNav" Style="{StaticResource Nav}" GroupName="Filter" Tag="updates" Checked="Filter_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Margin="0,1,13,0"/><TextBlock Text="Updates"/></StackPanel></RadioButton>
      </StackPanel>
      <StackPanel Grid.Row="3"><Button Content="Downloadquelle" Click="Settings_Click" Background="Transparent" Foreground="#C7CAE0" BorderBrush="#45465E" FontSize="12"/><Menu Background="Transparent" Foreground="#C7CAE0" HorizontalAlignment="Center" Margin="0,13,0,0"><MenuItem Header="Sprache / Language"><MenuItem Foreground="#22283D" x:Name="GermanMenu" Header="Deutsch" IsCheckable="True" Click="German_Click"/><MenuItem Foreground="#22283D" x:Name="EnglishMenu" Header="English" IsCheckable="True" Click="English_Click"/></MenuItem></Menu><TextBlock Text="XD SUITE · 0.3.0" FontSize="10" Foreground="#80839F" HorizontalAlignment="Center" Margin="0,17,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="30,26,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Programme verwalten" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Programme installieren, aktualisieren und starten." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,0" Height="43" VerticalAlignment="Center"><Grid><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="Programme suchen"/><TextBlock Text="Programme suchen …" Foreground="#9398AC" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
      <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ListHeading" Text="Alle Programme" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="12,4,0,0" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="RefreshButton" Content="Katalog aktualisieren" Click="Refresh_Click" FontSize="12" Padding="12,7" MinHeight="35"/></Grid>
      <Grid Grid.Row="3" Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="318"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,18,0"><ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="App_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Verfügbare Programme"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="White" BorderBrush="#E1E4EE" BorderThickness="1" CornerRadius="12" Padding="19"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8F86DD"/><Setter TargetName="B" Property="Background" Value="#FCFBFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#B1AACF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F7E9DE" Width="41" Height="41" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#A4512D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding Category}" Foreground="#8C849F" FontSize="11" Margin="0,4,0,9"/><TextBlock Text="{Binding Description}" Foreground="#74788B" FontSize="12" LineHeight="19"/><TextBlock Text="{Binding Status}" Foreground="#6255AD" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyText" Text="Keine Programme in dieser Ansicht." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22"><Grid x:Name="DetailPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="AUSGEWÄHLTES PROGRAMM" Foreground="#9994AA" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Margin="0,11,0,5"/><TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Features}" FontSize="12" Foreground="#5B6077" LineHeight="27" Margin="0,20,0,17"/><TextBlock Text="Eigenständig nutzbar. Die Suite muss zum Starten nicht geöffnet sein." FontSize="12" Foreground="#89889B" LineHeight="20"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1"><Button x:Name="ActionButton" Content="Herunterladen &amp; installieren" Click="Action_Click" Style="{StaticResource Primary}" FontSize="12" Margin="0,21,0,0"/><Button x:Name="LaunchButton" Content="Programm starten" Click="Launch_Click" FontSize="12" Margin="0,9,0,0" Visibility="Collapsed"/><TextBlock x:Name="PackageSizeText" Text="" FontSize="10" Foreground="#8D8CA1" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></Grid></Border>
      </Grid>
      <Border Grid.Row="4" Style="{StaticResource Card}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="StatusTitle" Text="Bereit" FontWeight="SemiBold" FontSize="13" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusText" Text="Programm zum Installieren oder Starten auswählen." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/><ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Height="5" Foreground="#6C5FD2" Background="#E9E7F5" BorderThickness="0" Margin="0,12,0,0"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Abbrechen" Click="Cancel_Click" FontSize="12" Visibility="Collapsed" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
