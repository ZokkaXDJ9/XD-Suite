<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>XDConverter.Preview</AssemblyName><Product>XD Konverter Vorschau</Product>
    <SuiteVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\XDSuite\XDSuite.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</SuiteVersion>
    <Version>$(SuiteVersion)</Version><InformationalVersion>$(SuiteVersion)-preview+automatic-defaults</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/XDConverter.ico</ApplicationIcon>
    <Description>Lokale Audiokonvertierung - Vorschau</Description>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/XDConverter.ico"/><Resource Include="Assets/XDConverter-256.png"/></ItemGroup>
</Project>
