<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/XDBurner.ico</ApplicationIcon>
    <Version>0.5.2</Version>
    <AssemblyName>XDBurner</AssemblyName>
    <Product>XD Brenner</Product>
    <Description>Daten-CDs und Audio-CDs brennen, ISO-Dateien erstellen und CD-RWs löschen.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BetaBuild Condition="'$(BetaBuild)' == ''">false</BetaBuild>
    <SuiteVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\XDSuite\XDSuite.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</SuiteVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BetaBuild)' == 'true'">
    <Version>$(SuiteVersion)</Version><InformationalVersion>$(Version)-Beta+burner.1</InformationalVersion>
    <AssemblyName>XDBurner.Beta</AssemblyName><Product>XD Burner Beta</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);BURNER_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XD.Common/XD.Common.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <EmbeddedResource Include="../tests/fixtures/tone.mp3" LogicalName="XDBurner.TestTone.mp3" />
    <EmbeddedResource Include="../tests/fixtures/tone.ogg" LogicalName="XDBurner.TestTone.ogg" />
    <Resource Include="Assets/XDBurner.ico" />
  </ItemGroup>
  <ItemGroup><Compile Include="../design/BetaChrome.cs" Link="BetaChrome.cs" /><Resource Include="Assets/Beta.ico" /></ItemGroup>
  <PropertyGroup Condition="'$(BetaBuild)' == 'true'"><ApplicationIcon>Assets/Beta.ico</ApplicationIcon></PropertyGroup>
</Project>
