<Window x:Class="XDBurner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XD Brenner" Icon="Assets/XDBurner.ico" Style="{StaticResource {x:Type Window}}" Width="1220" Height="850" MinWidth="1080" MinHeight="780" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EEF1E8" BorderBrush="#E0E5D9" BorderThickness="0,0,1,0">
      <Grid Margin="20,30,20,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="8,0,0,35">
          <StackPanel Orientation="Horizontal">
            <Grid Width="30" Height="30" Margin="0,0,10,0"><Ellipse Fill="#AF431F"/><Ellipse Width="10" Height="10" Fill="#EEF1E8"/><Ellipse Width="4" Height="4" Fill="#AF431F"/></Grid>
            <TextBlock Text="XD Brenner" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="Navigation">
          <TextBlock Text="BRENNEN" FontSize="10" FontWeight="Bold" Foreground="#74816D" Margin="15,0,0,13"/>
          <RadioButton x:Name="DataNav" Style="{StaticResource NavButton}" GroupName="Mode" Tag="Data" Checked="Mode_Checked" AutomationProperties.Name="Daten-CD erstellen">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="Daten-CD"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="AudioNav" Style="{StaticResource NavButton}" GroupName="Mode" Tag="Audio" Checked="Mode_Checked" AutomationProperties.Name="Audio-CD erstellen">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="Audio-CD"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="IsoNav" Style="{StaticResource NavButton}" GroupName="Mode" Tag="Iso" Checked="Mode_Checked" AutomationProperties.Name="ISO-Abbild brennen">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="ISO brennen"/></StackPanel>
          </RadioButton>
          <Border Height="1" Background="#DCE2D5" Margin="12,15,12,21"/>
          <TextBlock Text="WERKZEUGE" FontSize="10" FontWeight="Bold" Foreground="#74816D" Margin="15,0,0,13"/>
          <RadioButton x:Name="EraseNav" Style="{StaticResource NavButton}" GroupName="Mode" Tag="Erase" Checked="Mode_Checked" AutomationProperties.Name="Wiederbeschreibbare CD löschen">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="CD-RW löschen"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button Content="Hilfe &amp; Über XD Brenner" Click="Help_Click" Padding="4,8" Background="Transparent" BorderThickness="0" FontSize="12"/>
          <Menu Background="Transparent" HorizontalAlignment="Center" Margin="0,6,0,0"><MenuItem Header="Sprache / Language"><MenuItem x:Name="GermanMenu" Header="Deutsch" IsCheckable="True" Click="German_Click"/><MenuItem x:Name="EnglishMenu" Header="English" IsCheckable="True" Click="English_Click"/></MenuItem></Menu>
          <TextBlock Text="VERSION 0.5.2 · XD SUITE" FontSize="9" Foreground="#7A8672" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,27,32,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Daten-CD" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageDescription" Text="Dateien und Ordner auf CD brennen." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="84" Height="84" Margin="20,0,2,0">
          <Ellipse Fill="#E9EDE1" Stroke="#DCE2D2"/><Path Data="M42,3 A39,39 0 0 1 81,42 L54,42 A12,12 0 0 0 42,30 Z" Fill="#D9E3C7"/>
          <Path Data="M3,42 A39,39 0 0 0 42,81 L42,54 A12,12 0 0 1 30,42 Z" Fill="#E5CEB1"/>
          <Ellipse Width="28" Height="28" Fill="#F5F6F1" Stroke="#D0D9C4"/><Ellipse Width="9" Height="9" Fill="#C1CCB3"/>
        </Grid>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="7,0,15,0">
            <ComboBox x:Name="DriveCombo" DisplayMemberPath="Name" SelectionChanged="Drive_SelectionChanged" AutomationProperties.Name="CD-Brenner auswählen"/>
            <TextBlock x:Name="MediaText" Text="Brenner werden gesucht …" FontSize="12" Foreground="#68736E" Margin="2,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Content="Aktualisieren" Click="Refresh_Click" FontSize="12" Padding="12,9"/>
            <Button x:Name="EjectButton" Content="&#xE7F1;" FontFamily="Segoe MDL2 Assets" ToolTip="CD auswerfen" AutomationProperties.Name="CD auswerfen" Click="Eject_Click" Padding="12,9" Margin="7,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,20" x:Name="Editor">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,18,0">
          <Grid>
            <Grid x:Name="FilesPanel" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="19,18,19,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ListTitle" Text="Dateien und Ordner" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ItemCount" Text="Noch keine Dateien" FontSize="12" Foreground="#68736E" Margin="0,5,0,0"/></StackPanel>
                <Button Grid.Column="1" x:Name="ClearButton" Content="Leeren" Click="Clear_Click" FontSize="12" Padding="9,5" MinHeight="32"/>
              </Grid>
              <Grid Grid.Row="1" Margin="12,0">
                <DataGrid x:Name="FileGrid" AllowDrop="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0E8" Background="White" BorderThickness="0" RowHeight="46" FontSize="13" PreviewMouseLeftButtonDown="File_MouseDown" PreviewMouseMove="File_MouseMove" AutomationProperties.Name="Dateien oder Audiotitel der CD">
                  <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F7F3"/><Setter Property="Foreground" Value="#6C7767"/><Setter Property="Padding" Value="9,10"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding SourcePath}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                    <DataGridTextColumn Header="TYP" Binding="{Binding TypeLabel}" Width="92"/>
                    <DataGridTextColumn x:Name="SizeColumn" Header="GRÖSSE" Binding="{Binding SizeLabel}" Width="84"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" IsHitTestVisible="False">
                  <TextBlock Text="+" FontSize="39" FontWeight="Light" Foreground="#9BA88B" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="EmptyTitle" Text="Keine Dateien hinzugefügt." FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,7"/>
                  <TextBlock x:Name="EmptyHint" Text="Dateien hierher ziehen oder unten hinzufügen." TextAlignment="Center" Foreground="#68736E" FontSize="13"/>
                </StackPanel>
              </Grid>
              <WrapPanel Grid.Row="2" Margin="18,15,12,18">
                <Button x:Name="AddFilesButton" Content="+ Dateien" Click="AddFiles_Click" FontSize="12" Padding="12,8" Margin="0,0,7,5"/>
                <Button x:Name="AddFolderButton" Content="+ Ordner" Click="AddFolder_Click" FontSize="12" Padding="12,8" Margin="0,0,7,5"/>
                <Button Content="Entfernen" Click="Remove_Click" FontSize="12" Padding="10,8" Margin="0,0,7,5"/>
                <Button x:Name="UpButton" Content="↑" AutomationProperties.Name="Audiotitel nach oben" Click="Up_Click" Padding="11,8" Margin="0,0,5,5" Visibility="Collapsed"/>
                <Button x:Name="DownButton" Content="↓" AutomationProperties.Name="Audiotitel nach unten" Click="Down_Click" Padding="11,8" Margin="0,0,0,5" Visibility="Collapsed"/>
              </WrapPanel>
            </Grid>
            <StackPanel x:Name="IsoPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="30" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
              <TextBlock Text="ISO-Datei auswählen" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Wähle eine ISO-Datei aus. Ihr Inhalt wird als Daten-CD auf den Rohling geschrieben." Style="{StaticResource MutedText}"/>
              <Button Content="ISO-Datei auswählen …" Click="ChooseIso_Click" HorizontalAlignment="Left" Margin="0,22,0,15"/>
              <TextBlock x:Name="IsoPathText" Text="Noch keine ISO-Datei ausgewählt." Foreground="#68736E"/>
              <TextBlock Text="ISO 9660 · Kein BIN/CUE oder Audio-Abbild" FontSize="12" Foreground="#7B8576" Margin="0,20,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ErasePanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="30">
              <TextBlock Text="CD-RW löschen" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="Eine wiederbeschreibbare CD-RW lässt sich leeren und danach erneut brennen. CD-Rs können nicht gelöscht werden." Style="{StaticResource MutedText}"/>
              <Border Background="#FFF3E4" CornerRadius="8" Padding="15" Margin="0,23,0,0"><TextBlock Text="Beim Löschen gehen alle Inhalte auf der eingelegten CD-RW verloren." Foreground="#885027" LineHeight="22"/></Border>
              <TextBlock Text="Schnelles Löschen gibt die CD wieder frei. Vollständiges Löschen dauert je nach Laufwerk mehrere Minuten." Style="{StaticResource MutedText}" FontSize="12" Margin="0,19,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Optionen" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <StackPanel x:Name="VolumePanel"><TextBlock Text="NAME DER CD" FontSize="10" FontWeight="SemiBold" Foreground="#68736E" Margin="0,0,0,8"/><TextBox x:Name="VolumeNameBox" Text="MEINE_DISC" MaxLength="32" AutomationProperties.Name="Name der Daten-CD" Margin="0,0,0,16"/></StackPanel>
              <StackPanel x:Name="WriteSettings">
                <TextBlock Text="GESCHWINDIGKEIT" FontSize="10" FontWeight="SemiBold" Foreground="#68736E" Margin="0,0,0,8"/>
                <ComboBox x:Name="SpeedCombo" SelectedIndex="0" AutomationProperties.Name="Brenngeschwindigkeit"><ComboBoxItem Content="Automatisch"/><ComboBoxItem Content="Langsamste verfügbare"/></ComboBox>
                <CheckBox x:Name="VerifyCheck" IsChecked="True" Content="Daten nach dem Brennen prüfen" FontSize="12" Margin="0,15,0,7"/>
              </StackPanel>
              <StackPanel x:Name="GapPanel" Visibility="Collapsed" Margin="0,8,0,8"><TextBlock Text="PAUSE ZWISCHEN TITELN" FontSize="10" Foreground="#68736E" Margin="0,0,0,8"/><ComboBox x:Name="GapCombo" SelectedIndex="2" SelectionChanged="Gap_Changed" AutomationProperties.Name="Pause zwischen Audiotiteln"><ComboBoxItem Content="0 s" Tag="0"/><ComboBoxItem Content="1 s" Tag="1"/><ComboBoxItem Content="2 s" Tag="2"/><ComboBoxItem Content="3 s" Tag="3"/><ComboBoxItem Content="5 s" Tag="5"/><ComboBoxItem Content="10 s" Tag="10"/></ComboBox><TextBlock Text="0 s: keine zusätzliche Pause." FontSize="10" Foreground="#68736E" Margin="0,5,0,0"/></StackPanel>
              <CheckBox x:Name="FullEraseCheck" Visibility="Collapsed" Content="Vollständig löschen" FontSize="12"/>
              <CheckBox x:Name="EjectCheck" IsChecked="True" Content="CD danach auswerfen" FontSize="12"/>
              <Border x:Name="InfoSeparator" Height="1" Background="#E7EAE1" Margin="0,12,0,12"/>
              <TextBlock x:Name="ModeHint" Text="Für Dateien, Fotos und MP3-Sammlungen. Ordner bleiben erhalten. Die CD wird abgeschlossen." FontSize="12" Foreground="#68736E" LineHeight="21"/>
            </StackPanel>
          </ScrollViewer>
              <Border Grid.Row="1" x:Name="CapacityPanel" Background="#F3F5ED" CornerRadius="8" Padding="13" Margin="0,15,0,0">
                <StackPanel><TextBlock x:Name="CapacityTitle" Text="PLATZ AUF DER CD" FontSize="9" FontWeight="Bold" Foreground="#68736E"/><TextBlock x:Name="CapacityText" Text="0 B / ca. 700 MB" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock x:Name="CapacityDifference" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><ProgressBar x:Name="CapacityBar" Height="5" Value="0" Background="#E0E6D6" Foreground="#7B9567" BorderThickness="0"/><TextBlock x:Name="CapacityHint" Text="Richtwert ohne Rohling" FontSize="10" Foreground="#7B8576" Margin="0,8,0,0"/></StackPanel>
              </Border>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="19,17">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="StatusTitle" Text="Bereit" FontSize="14" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="StatusText" Text="Dateien oder Ordner hinzufügen." FontSize="12" Foreground="#68736E" Margin="0,5,0,0" MaxHeight="55"/>
            <ProgressBar x:Name="OperationBar" Height="5" Margin="0,12,0,0" Visibility="Collapsed" Foreground="#AF431F" Background="#EFE5DD" BorderThickness="0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ExportButton" Content="Als ISO speichern" Click="Export_Click" FontSize="12" Padding="13,12" Margin="0,0,9,0"/>
            <Button x:Name="StartButton" Content="CD brennen" Click="Start_Click" Style="{StaticResource PrimaryButton}" Padding="21,12"/>
            <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" Visibility="Collapsed" Padding="15,12"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
