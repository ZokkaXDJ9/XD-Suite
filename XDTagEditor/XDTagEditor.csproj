<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.5.2</Version><InformationalVersion>$(Version)-Beta+tag-editor.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><AssemblyName>XDTagEditor.Beta</AssemblyName><Product>XD Tag Editor Beta</Product>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="TagLibSharp" Version="2.3.0"/><Resource Include="Assets/App.ico"/></ItemGroup>
  <Target Name="ValidateSuiteVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup><SuiteVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\XDSuite\XDSuite.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</SuiteVersion></PropertyGroup>
    <Error Condition="'$(Version)' != '$(SuiteVersion)'" Text="Preview version must match the suite working version."/>
  </Target>
</Project>
